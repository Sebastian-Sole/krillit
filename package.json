  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module"
}
